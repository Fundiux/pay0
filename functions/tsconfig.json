{
    "compilerOptions":  {
                            "module":  "commonjs",
                            "esModuleInterop":  true,
                            "moduleResolution":  "node",
                            "noImplicitReturns":  true,
                            "noUnusedLocals":  false,
                            "outDir":  "lib",
                            "sourceMap":  true,
                            "strict":  true,
                            "target":  "es2017",
                            "noUnusedParameters":  false
                        },
    "compileOnSave":  true,
    "include":  [
                    "src"
                ]
}
