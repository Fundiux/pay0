{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "build": "tsc && node ../scripts/copy-canonical-assets.mjs",
    "lint": "eslint --ext .js,.ts .",
    "seed:perf": "node scripts/seed-performance-fixtures.mjs",
    "verify:operation-roles": "node scripts/verify-operation-role-access.mjs",
    "verify:whatsapp-automation": "node scripts/verify-whatsapp-automation.mjs",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "@google-cloud/vision": "^6.1.0",
    "@sparticuz/chromium": "^147.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "seek-bzip": "^2.0.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3"
  },
  "private": true,
  "overrides": {
    "protobufjs": "7.6.5",
    "websocket-driver": "0.7.5"
  }
}
