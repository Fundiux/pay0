{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "build": "tsc",
    "lint": "eslint --ext .js,.ts .",
    "seed:perf": "node scripts/seed-performance-fixtures.mjs",
    "verify:operation-roles": "node scripts/verify-operation-role-access.mjs",
    "verify:whatsapp-automation": "node scripts/verify-whatsapp-automation.mjs",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/vision": "^6.0.0",
    "firebase-admin": "^13.6.1",
    "firebase-functions": "^7.2.5",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "private": true,
  "overrides": {
    "protobufjs": "7.6.5",
    "websocket-driver": "0.7.5"
  }
}
