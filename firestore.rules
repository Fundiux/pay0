rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    function restrictionId(value) { return value.matches('[A-Za-z0-9_-]{1,128}'); }
    function restrictionMillis(value) { return value is int && value >= 0 && value <= 253402300799999; }
    function restrictionRoot(user, subjectUid) {
      let root = user.get('rootId', null);
      return root == null || root == '' || root == false || root == 0 ? subjectUid : root;
    }
    // Every required property is accessed below; exact map size rejects unknown fields.
    // ACTIVE has15 mandatory fields; REVOKED has18, including all3 revocation fields.
    function restrictionAllowsMap(row, rootId, subjectUid) {
      let nowMs = request.time.toMillis();
      let state = row.get('state', null);
      let issuedAt = row.get('issuedAtMs', null);
      let expiresAt = row.get('expiresAtMs', null);
      let revokedAt = row.get('revokedAtMs', null);
      let revokedBy = row.get('revokedBy', null);
      // Keep the full schema and terminal-state validation in one context.
      return ((state == 'ACTIVE' && expiresAt is int && expiresAt > nowMs) ? false : (
        row.keys().size() == (state == 'ACTIVE' ? 15 : 18)
        && row.schemaVersion == 1
        && row.writer == 'PAY0_TRUSTED_RESTRICTION_WRITER@1'
        && row.policyVersion == 'PAY0-CONTAINMENT@1'
        && restrictionId(row.restrictionId)
        && restrictionId(rootId) && row.rootId == rootId
        && restrictionId(subjectUid) && row.subjectUid == subjectUid
        && row.scope == 'ACCOUNT_OPERATIONS'
        && row.authority == 'HUMAN_SECURITY_ADMIN'
        && restrictionId(row.authorityUid) && row.authorityUid != subjectUid
        && restrictionId(row.incidentId)
        && row.reasonCode in ['SECURITY_REVIEW','CREDENTIAL_COMPROMISE_CONFIRMED','SUPPORT_CONTAINMENT']
        && row.authorizationVersion is int && row.authorizationVersion >= 1 && row.authorizationVersion <= 9007199254740991
        && restrictionMillis(issuedAt) && restrictionMillis(expiresAt)
        && issuedAt <= nowMs && expiresAt > issuedAt
        && expiresAt - issuedAt <= 86400000
      )) ? (
        state == 'ACTIVE' ? expiresAt <= nowMs : (
          state == 'REVOKED' && restrictionMillis(revokedAt)
          && revokedAt >= issuedAt && revokedAt <= nowMs
          && restrictionId(revokedBy) && revokedBy != subjectUid
          && row.revocationReason in ['REVIEW_CLEARED','CREDENTIALS_RECOVERED','SUPPORT_RECOVERY']
        )
      ) : false;
    }
    function restrictionAllowsRecord(row, rootId, subjectUid) {
      return row is map ? restrictionAllowsMap(row, rootId, subjectUid) : false;
    }
    function restrictionAllowsUserForUid(user, subjectUid, rootId) {
      return !user.keys().hasAny(['trustedRestrictionV1']) ? true
        : restrictionAllowsRecord(user.trustedRestrictionV1, rootId, subjectUid);
    }
    function restrictionAllowsUser(user) { return restrictionAllowsUserForUid(user, me(), restrictionRoot(user, me())); }
    function userLifecycleActive(user) {
      return user.get('isDeleted', false) != true && user.get('deleted', false) != true
        && user.get('disabled', false) != true && user.get('deletedAt', null) == null
        && user.get('isActive', true) != false && user.get('active', true) != false;
    }

    function accountAllowed() { return authenticated() && restrictionAllowsUser(userDoc(me())); }
    function authenticated() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function signedIn() {
      let user = userDoc(me());
      return authenticated() && userExists(me())
        && user.get("isDeleted", false) != true
        && user.get("deleted", false) != true
        && user.get("disabled", false) != true
        && user.get("deletedAt", null) == null
        && user.get("isActive", true) != false
        && user.get("active", true) != false;
    }

    function myRole() {
      let role = userDoc(me()).get("role", "");
      return role == "operator" ? "operador" : role;
    }

    function isSuperadmin() { return userDoc(me()).get("role", "") == "superadmin"; }
    function isAdmin() { return userDoc(me()).get("role", "") == "admin"; }
    function isOperador() { return userDoc(me()).get("role", "") in ["operator", "operador"]; }

    // AUTHORIZATION_POLICY_GENERATED_START PAY0-USERS-PERMISSIONS@1
    function roleDefaultAllows(moduleKey, actionKey) {
      // Canonical renderer v1: cache role and select modules by action.
      let role = myRole();
      let modules = role == "admin"
        ? (
          actionKey == "view" ? ["actividad", "clientes", "dashboard", "despachos", "empresas", "modulos", "pagos", "reportes", "solicitudes", "telegram", "usuarios", "wallet"]
          : actionKey == "activate" ? ["usuarios"]
          : actionKey == "adelantos" ? ["wallet"]
          : actionKey == "beneficiarios" ? ["wallet"]
          : actionKey == "cancel" ? ["pagos", "solicitudes"]
          : actionKey == "clientDelegations" ? ["usuarios"]
          : actionKey == "comment" ? ["solicitudes"]
          : actionKey == "configuracion" ? ["wallet"]
          : actionKey == "costs" ? ["clientes", "despachos", "usuarios"]
          : actionKey == "create" ? ["clientes", "pagos", "solicitudes", "usuarios"]
          : actionKey == "dispersiones" ? ["wallet"]
          : actionKey == "edit" ? ["clientes", "modulos", "pagos", "solicitudes"]
          : actionKey == "estadoCuentaCliente" ? ["wallet"]
          : actionKey == "estadoCuentaUsuario" ? ["wallet"]
          : actionKey == "link" ? ["telegram"]
          : actionKey == "permissions" ? ["usuarios"]
          : actionKey == "saldos" ? ["wallet"]
          : actionKey == "uploadDocs" ? ["pagos", "solicitudes"]
          : []
        )
        : role == "operador"
          ? (
            actionKey == "view" ? ["actividad", "clientes", "dashboard", "despachos", "empresas", "pagos", "reportes", "solicitudes", "telegram", "wallet"]
            : actionKey == "beneficiarios" ? ["wallet"]
            : actionKey == "comment" ? ["solicitudes"]
            : actionKey == "create" ? ["clientes", "pagos", "solicitudes"]
            : actionKey == "dispersiones" ? ["wallet"]
            : actionKey == "link" ? ["telegram"]
            : actionKey == "uploadDocs" ? ["pagos", "solicitudes"]
            : []
          )
          : [];
      return role == "superadmin" || moduleKey in modules;
    }
    function roleDefaultAllowsForRole(role, moduleKey, actionKey) {
      // Canonical renderer v1: cache role and select modules by action.
      let modules = role == "admin"
        ? (
          actionKey == "view" ? ["actividad", "clientes", "dashboard", "despachos", "empresas", "modulos", "pagos", "reportes", "solicitudes", "telegram", "usuarios", "wallet"]
          : actionKey == "activate" ? ["usuarios"]
          : actionKey == "adelantos" ? ["wallet"]
          : actionKey == "beneficiarios" ? ["wallet"]
          : actionKey == "cancel" ? ["pagos", "solicitudes"]
          : actionKey == "clientDelegations" ? ["usuarios"]
          : actionKey == "comment" ? ["solicitudes"]
          : actionKey == "configuracion" ? ["wallet"]
          : actionKey == "costs" ? ["clientes", "despachos", "usuarios"]
          : actionKey == "create" ? ["clientes", "pagos", "solicitudes", "usuarios"]
          : actionKey == "dispersiones" ? ["wallet"]
          : actionKey == "edit" ? ["clientes", "modulos", "pagos", "solicitudes"]
          : actionKey == "estadoCuentaCliente" ? ["wallet"]
          : actionKey == "estadoCuentaUsuario" ? ["wallet"]
          : actionKey == "link" ? ["telegram"]
          : actionKey == "permissions" ? ["usuarios"]
          : actionKey == "saldos" ? ["wallet"]
          : actionKey == "uploadDocs" ? ["pagos", "solicitudes"]
          : []
        )
        : role == "operador"
          ? (
            actionKey == "view" ? ["actividad", "clientes", "dashboard", "despachos", "empresas", "pagos", "reportes", "solicitudes", "telegram", "wallet"]
            : actionKey == "beneficiarios" ? ["wallet"]
            : actionKey == "comment" ? ["solicitudes"]
            : actionKey == "create" ? ["clientes", "pagos", "solicitudes"]
            : actionKey == "dispersiones" ? ["wallet"]
            : actionKey == "link" ? ["telegram"]
            : actionKey == "uploadDocs" ? ["pagos", "solicitudes"]
            : []
          )
          : [];
      return role == "superadmin" || moduleKey in modules;
    }
    function roleAllowsClientDelegation(role) {
      return role == "superadmin" || role in ["admin"];
    }
    // AUTHORIZATION_POLICY_GENERATED_END

    function individualAllows(moduleKey, actionKey) {
      return userDoc(me())
        .get("modules", {})
        .get(moduleKey, {})
        .get(actionKey, true) == true;
    }

    function individualAllowsViewAndAction(moduleKey, actionKey) {
      let access = userDoc(me()).get("modules", {}).get(moduleKey, {});
      return access.get("view", true) == true && (actionKey == "view" || access.get(actionKey, true) == true);
    }
    function individualAllowsViewAndActionForUser(user, moduleKey, actionKey) {
      let access = user.get("modules", {}).get(moduleKey, {});
      return access.get("view", true) == true && (actionKey == "view" || access.get(actionKey, true) == true);
    }
    function hasModuleAction(moduleKey, actionKey) {
      let uid = me();
      let user = userDoc(uid);
      let rawRole = user.get("role", "");
      let role = rawRole == "operator" ? "operador" : rawRole;
      return (authenticated() && userExists(uid) && userLifecycleActive(user)) ? (
        role == "superadmin" ? true : (
          roleDefaultAllowsForRole(role, moduleKey, "view")
          && (actionKey == "view" ? true : roleDefaultAllowsForRole(role, moduleKey, actionKey))
          && individualAllowsViewAndActionForUser(user, moduleKey, actionKey)
        )
      ) : false;
    }

    function hasModuleView(moduleKey) {
      return hasModuleAction(moduleKey, "view");
    }

    function myRootId() {
      let root = userDoc(me()).get("rootId", null);
      return root != null ? root : me();
    }

    function targetRootId(uid) {
      return userExists(uid)
        ? (userDoc(uid).rootId != null ? userDoc(uid).rootId : uid)
        : uid;
    }

    function targetParentUserId(uid) {
      return userExists(uid) ? userDoc(uid).parentUserId : null;
    }

    function targetParentRole(uid) {
      return userExists(uid)
        ? (
            userDoc(uid).parentRole == "operator"
              ? "operador"
              : userDoc(uid).parentRole
          )
        : null;
    }

    function targetDespachoId(uid) {
      return userExists(uid) ? userDoc(uid).despachoId : null;
    }

    function sameRoot(uid) {
      return userExists(uid) && targetRootId(uid) == myRootId();
    }

    function iManageUser(uid) {
      return isAdmin()
        && userExists(uid)
        && targetParentUserId(uid) == me()
        && targetParentRole(uid) == "admin"
        && sameRoot(uid);
    }

    function canReadUser(uid) {
      return signedIn() && (
        isSuperadmin()
        || me() == uid
        || (hasModuleView("usuarios") && iManageUser(uid))
      );
    }

    function hasCompanyAccess(companyId) {
      return exists(/databases/$(database)/documents/userCompanyAccess/$(me())/companies/$(companyId))
        && get(/databases/$(database)/documents/userCompanyAccess/$(me())/companies/$(companyId)).data.active == true;
    }

    function validDelegationTime(value, expiry) {
      return value == null ? true : (
        value is timestamp ? (expiry ? value > request.time : value <= request.time)
        : (value is number && value > 0 && value <= 253402300799999 && (expiry ? value > request.time.toMillis() : value <= request.time.toMillis()))
      );
    }

    // Immediate grantor guard only. DELEGATED ancestry remains a separate gate.
    function delegationFalsy(value) { return value == null || value == false || value == 0 || value == ''; }
    function delegationCleanId(value) {
      return value is string ? value.trim() : (delegationFalsy(value) ? '' : (value is number || value is bool ? string(value) : ''));
    }
    function delegationProfileRole(user) {
      let raw = user.get('role', null);
      let selected = raw == null ? user.get('supervisorRole', '') : raw;
      let role = selected is string ? selected.trim().lower() : '';
      return role == 'operator' ? 'operador' : role;
    }
    function delegationProfileModuleAllows(user, role) {
      let stored = user.get('modules', {});
      let raw = stored is map ? stored.get('usuarios', {}) : {};
      let actions = raw is map ? raw : {};
      return role == 'superadmin' ? true : (
        roleAllowsClientDelegation(role)
        && actions.get('view', true) == true && actions.get('clientDelegations', true) == true
      );
    }
    function delegationDirectGrantor(client, uid) {
      return delegationCleanId(client.get('adminId', null)) == uid
        || delegationCleanId(client.get('ownerId', null)) == uid
        || delegationCleanId(client.get('managedByUserId', null)) == uid
        || delegationCleanId(client.get('createdBy', null)) == uid
        || delegationCleanId(client.get('operadorId', null)) == uid;
    }
    function delegationGrantorProfileAllowed(uid, source, client, rootId) {
      let user = userDoc(uid);
      let role = delegationProfileRole(user);
      return userLifecycleActive(user)
        && delegationCleanId(restrictionRoot(user, uid)) == rootId
        && restrictionAllowsUserForUid(user, uid, rootId)
        && role in ['superadmin', 'admin']
        && delegationProfileModuleAllows(user, role)
        && (source == 'SUPERADMIN' ? role == 'superadmin'
          : (source == 'DIRECT' ? (role == 'superadmin' || delegationDirectGrantor(client, uid)) : true));
    }
    function delegationAuthorityShapeValid(authority) {
      return authority is map && authority.get('version', null) == 1
        && authority.get('source', null) in ['SUPERADMIN', 'DIRECT', 'DELEGATED']
        && authority.get('grantorUid', null) is string && authority.grantorUid.trim() != '';
    }
    function delegationIdentifiedGrantorAllowed(uid, source, client, rootId) {
      return uid != me() && !uid.matches('.*[/].*')
        && delegationGrantorProfileAllowed(uid, source, client, rootId);
    }
    function delegationLegacyGrantorAllowed(raw, client, rootId) {
      let uid = delegationCleanId(raw);
      return (raw == null || raw is string || raw is number || raw is bool)
        && (uid == '' ? true : delegationIdentifiedGrantorAllowed(uid, '', client, rootId));
    }
    function delegationLegacyAuthorityAllowed(access, client, rootId) {
      let grantedBy = access.get('grantedBy', null);
      return delegationLegacyGrantorAllowed(delegationFalsy(grantedBy) ? access.get('createdBy', null) : grantedBy, client, rootId);
    }
    function delegationExplicitAuthorityAllowed(authority, clientId, client, rootId) {
      return delegationAuthorityShapeValid(authority) ? (
        (authority.source == 'DELEGATED'
          ? authority.get('parentPath', null) == 'userClientAccess/' + authority.grantorUid.trim() + '/clients/' + clientId : true)
        && delegationIdentifiedGrantorAllowed(authority.grantorUid.trim(), authority.source, client, rootId)
      ) : false;
    }
    function delegationImmediateGrantorAllowed(access, clientId, client, rootId) {
      // Keep absent provenance compatible; do not infer a historical parent.
      return access.keys().hasAny(['grantAuthority'])
        ? delegationExplicitAuthorityAllowed(access.grantAuthority, clientId, client, rootId)
        : delegationLegacyAuthorityAllowed(access, client, rootId);
    }

    function clientDelegationPermissionForClient(clientId, client, rootId, permission, legacy) {
      let uid = me();
      let path = /databases/$(database)/documents/userClientAccess/$(uid)/clients/$(clientId);
      let access = get(path).data;
      let permissions = access.get("permissions", {});
      return (clientId != null && exists(path)) ? (
        access.active == true
        && access.get("rootId", rootId) == rootId
        && client.get("rootId", rootId) == rootId
        && client.get("active", true) != false
        && access.get("targetUid", uid) == uid
        && access.get("clientId", clientId) == clientId
        && access.get("revokedAt", null) == null
        && (access.get("mode", "PERMANENT") != "TEMPORARY" || access.get("expiresAt", null) != null)
        && validDelegationTime(access.get("expiresAt", null), true)
        && validDelegationTime(access.get("startsAt", null), false)
        && permissions is map
        && permissions.get(permission, permissions.get(legacy, true)) == true
          ? delegationImmediateGrantorAllowed(access, clientId, client, rootId) : false
      ) : false;
    }

    function clientDelegationPermission(clientId, permission, legacy) {
      let rootId = myRootId();
      let client = get(/databases/$(database)/documents/clients/$(clientId)).data;
      return clientDelegationPermissionForClient(clientId, client, rootId, permission, legacy);
    }

    function hasClientBasicAccess(clientId) {
      return clientDelegationPermission(clientId, "viewBasic", "view");
    }

    function hasClientAccess(clientId) { return hasClientBasicAccess(clientId); }

    function hasClientSolicitudAccess(clientId) {
      return clientDelegationPermission(clientId, "operateSolicitudes", "operate");
    }

    function hasClientPagoAccess(clientId) {
      return clientDelegationPermission(clientId, "operatePagos", "operate");
    }

    function hasWalletClientReadAccess(clientId) {
      let clientPath = /databases/$(database)/documents/clients/$(clientId);
      let client = get(clientPath).data;
      let uid = me();
      let role = myRole();
      let rootId = myRootId();
      let direct = (role == "admin" && (
        client.get("adminId", null) == uid
        || client.get("ownerId", null) == uid
        || client.get("managedByUserId", null) == uid
        || client.get("createdBy", null) == uid
        || client.get("operadorId", null) == uid
      )) || (role == "operador" && (
        client.get("managedByUserId", null) == uid
        || client.get("operadorId", null) == uid
        || client.get("createdBy", null) == uid
      ));
      return (clientId != null && exists(clientPath) && client.rootId == rootId)
        ? (direct ? true : clientDelegationPermissionForClient(clientId, client, rootId, "viewBasic", "view")) : false;
    }

    function hasWalletClientReadAccessFromData(data) {
      let clientId = data.get('clientId', null);
      let legacyId = data.get('clienteId', null);
      return (('clientId' in data) && hasWalletClientReadAccess(clientId))
        || (legacyId != clientId ? (('clienteId' in data) && hasWalletClientReadAccess(legacyId)) : false);
    }

    function hasClientSolicitudAccessFromData(data) {
      let rootId = myRootId();
      let clientId = data.get("clientId", null);
      let legacyId = data.get("clienteId", null);
      return data.get("rootId", rootId) == rootId && (
        (("clientId" in data) && hasClientSolicitudAccess(clientId))
        || (("clienteId" in data) && legacyId != clientId && hasClientSolicitudAccess(legacyId))
      );
    }

    function hasClientPagoAccessFromData(data) {
      let rootId = myRootId();
      let clientId = data.get("clientId", null);
      let legacyId = data.get("clienteId", null);
      return data.get("rootId", rootId) == rootId && (
        (("clientId" in data) && hasClientPagoAccess(clientId))
        || (("clienteId" in data) && legacyId != clientId && hasClientPagoAccess(legacyId))
      );
    }


    function hasDespachoAccess(despachoId) {
      return despachoId != null
        && exists(/databases/$(database)/documents/userDespachoAccess/$(me())/despachos/$(despachoId))
        && get(/databases/$(database)/documents/userDespachoAccess/$(me())/despachos/$(despachoId)).data.active == true;
    }

    function despachoAllowsCompany(despachoId, companyId) {
      return despachoId != null
        && exists(/databases/$(database)/documents/dispatchCompanyAccess/$(despachoId)/companies/$(companyId))
        && get(/databases/$(database)/documents/dispatchCompanyAccess/$(despachoId)/companies/$(companyId)).data.active == true;
    }

    match /system/{docId} {
      allow read: if accountAllowed() && (signedIn());
      allow write: if false;
    }
    match /users/{uid} {
      // Preserve own active profile bootstrap; no lists, writes or economic collections.
      allow get: if authenticated() && me() == uid && userLifecycleActive(resource.data);
      allow read: if accountAllowed() && (canReadUser(uid));
      allow create, update, delete: if false;

      match /costos/{costId} {
        allow read: if accountAllowed() && (hasModuleAction("usuarios", "costs") && (isSuperadmin() || me() == uid || iManageUser(uid)));
        allow write: if accountAllowed() && (signedIn() && isSuperadmin());
      }
    }

    // Login aliases and throttling are server-only. Never expose an anonymous
    // username directory, email resolution or client-writable reservations.
    match /authUsernames/{id} {
      allow read, write: if false;
    }
    match /authLoginLimits/{id} {
      allow read, write: if false;
    }

    match /despachos/{docId} {
      allow read: if accountAllowed() && (hasModuleView("despachos") && (
        isSuperadmin()
        || (isAdmin() && resource.data.rootId == myRootId())
        || (isOperador() && resource.data.rootId == myRootId())
      ));
      allow write: if accountAllowed() && (signedIn() && isSuperadmin());
      match /costos/{costId} {
        allow read: if accountAllowed() && (hasModuleAction("despachos", "costs") && (
          isSuperadmin()
          || (isAdmin() && resource.data.rootId == myRootId())
          || (isOperador() && resource.data.rootId == myRootId())
        ));
        allow write: if accountAllowed() && (signedIn() && isSuperadmin());
      }
    }

    match /operationTypes/{docId} {
      allow read: if accountAllowed() && (signedIn());
      allow create, update, delete: if false;
    }

    match /companies/{companyId} {
      allow read: if accountAllowed() && (hasModuleView("empresas") && (
        isSuperadmin()
        || hasCompanyAccess(companyId)
        || (("despachoId" in resource.data) && hasDespachoAccess(resource.data.despachoId))
      ));
      allow write: if accountAllowed() && (signedIn() && isSuperadmin());
    }

    match /clients/{docId} {
      allow read: if accountAllowed() && (hasModuleView("clientes") && (
        isSuperadmin()
        || (("adminId" in resource.data) && resource.data.adminId == me())
        || (("createdBy" in resource.data) && resource.data.createdBy == me())
        || (("managedByUserId" in resource.data) && resource.data.managedByUserId == me())
        || (("operadorId" in resource.data) && resource.data.operadorId == me())
        || hasClientAccess(docId)
      ));

      allow create, update, delete: if false;

      match /costos/{costId} {
        allow read: if accountAllowed() && (hasModuleAction("clientes", "costs") && (
          isSuperadmin()
          || (("adminId" in get(/databases/$(database)/documents/clients/$(docId)).data)
              && get(/databases/$(database)/documents/clients/$(docId)).data.adminId == me())
          || (("createdBy" in get(/databases/$(database)/documents/clients/$(docId)).data)
              && get(/databases/$(database)/documents/clients/$(docId)).data.createdBy == me())
          || (("managedByUserId" in get(/databases/$(database)/documents/clients/$(docId)).data)
              && get(/databases/$(database)/documents/clients/$(docId)).data.managedByUserId == me())
          || (("operadorId" in get(/databases/$(database)/documents/clients/$(docId)).data)
              && get(/databases/$(database)/documents/clients/$(docId)).data.operadorId == me())
        ));
        allow write: if false;
      }
    }

    match /entityDocuments/{docId} {
      allow read: if accountAllowed() && (signedIn() && isSuperadmin());
      allow create, update, delete: if false;
    }
    match /uploads/{docId} {
      allow read: if accountAllowed() && (signedIn() && (
        isSuperadmin()
        || resource.data.rootId == myRootId()
        || resource.data.adminId == me()
        || resource.data.createdBy == me()
      ));
      allow create, update, delete: if false;
    }
    match /solicitudes/{docId} {
      allow read: if accountAllowed() && (hasModuleView("solicitudes") && (
        isSuperadmin()
        || resource.data.adminId == me()
        || resource.data.createdBy == me()
        || hasClientSolicitudAccessFromData(resource.data)
      ));

      allow create, update, delete: if false;

      match /notas/{notaId} {
        allow read: if accountAllowed() && (hasModuleView("solicitudes") && (
          isSuperadmin()
          || get(/databases/$(database)/documents/solicitudes/$(docId)).data.adminId == me()
          || get(/databases/$(database)/documents/solicitudes/$(docId)).data.createdBy == me()
          || hasClientSolicitudAccessFromData(get(/databases/$(database)/documents/solicitudes/$(docId)).data)
        ));

        allow create: if accountAllowed() && (hasModuleAction("solicitudes", "comment") && (
          isSuperadmin()
          || get(/databases/$(database)/documents/solicitudes/$(docId)).data.adminId == me()
          || get(/databases/$(database)/documents/solicitudes/$(docId)).data.createdBy == me()
          || hasClientSolicitudAccessFromData(get(/databases/$(database)/documents/solicitudes/$(docId)).data)
        ));

        allow update, delete: if accountAllowed() && (signedIn() && isSuperadmin());
      }
    }
    match /pagos/{pagoId} {
      allow read: if accountAllowed() && (hasModuleView("pagos") && (
        isSuperadmin()
        || resource.data.adminId == me()
        || resource.data.createdBy == me()
        || hasClientPagoAccessFromData(resource.data)
      ));

      allow create, update, delete: if false;

      match /notas/{notaId} {
        allow read: if accountAllowed() && (hasModuleView("pagos") && (
          isSuperadmin()
          || get(/databases/$(database)/documents/pagos/$(pagoId)).data.adminId == me()
          || get(/databases/$(database)/documents/pagos/$(pagoId)).data.createdBy == me()
          || hasClientPagoAccessFromData(get(/databases/$(database)/documents/pagos/$(pagoId)).data)
        ));

        allow create, update, delete: if false;
      }
    }
    match /pagoAplicaciones/{aplicacionId} {
      allow read: if accountAllowed() && (hasModuleAction("pagos", "create") && (
        isSuperadmin()
        || (
          resource.data.get("rootId", null) == myRootId()
          && (
            resource.data.get("adminId", null) == me()
            || resource.data.get("createdBy", null) == me()
          )
        )
        || (
          ("solicitudId" in resource.data)
          && (
            get(/databases/$(database)/documents/solicitudes/$(resource.data.solicitudId)).data.get("adminId", null) == me()
            || get(/databases/$(database)/documents/solicitudes/$(resource.data.solicitudId)).data.get("createdBy", null) == me()
            || hasClientPagoAccessFromData(
              get(/databases/$(database)/documents/solicitudes/$(resource.data.solicitudId)).data
            )
          )
        )
      ));

      allow read: if accountAllowed() && (hasModuleAction("pagos", "conciliate") && (
        isSuperadmin()
        || (
          resource.data.get("rootId", null) == myRootId()
          && (
            resource.data.get("adminId", null) == me()
            || resource.data.get("createdBy", null) == me()
          )
        )
        || (
          ("solicitudId" in resource.data)
          && (
            get(/databases/$(database)/documents/solicitudes/$(resource.data.solicitudId)).data.get("adminId", null) == me()
            || get(/databases/$(database)/documents/solicitudes/$(resource.data.solicitudId)).data.get("createdBy", null) == me()
            || hasClientPagoAccessFromData(
              get(/databases/$(database)/documents/solicitudes/$(resource.data.solicitudId)).data
            )
          )
        )
      ));

      allow create, update, delete: if false;
    }
    match /pagoApplicationReservations/{reservationId} {
      allow read: if accountAllowed() && (hasModuleAction("pagos", "conciliate") && (
        isSuperadmin()
        || resource.data.adminId == me()
        || resource.data.createdBy == me()
      ));

      allow create, update, delete: if false;
    }
    match /pagoApplicationIqPlans/{planId} {
      allow read: if accountAllowed() && (hasModuleAction("pagos", "conciliate") && (
        isSuperadmin()
        || resource.data.adminId == me()
        || resource.data.createdBy == me()
      ));
      allow create, update, delete: if false;
    }
    match /pagoApplicationIqPlanItems/{itemId} {
      allow read: if accountAllowed() && (hasModuleAction("pagos", "conciliate") && (
        isSuperadmin()
        || resource.data.adminId == me()
        || resource.data.createdBy == me()
      ));
      allow create, update, delete: if false;
    }
    match /pagoApplicationIqAttempts/{attemptId} {
      allow read: if accountAllowed() && (hasModuleAction("pagos", "conciliate") && (
        isSuperadmin()
        || resource.data.adminId == me()
        || resource.data.createdBy == me()
      ));
      allow create, update, delete: if false;
    }
    match /pagoApplicationIqLocks/{lockId} {
      allow read: if accountAllowed() && (hasModuleAction("pagos", "conciliate") && (
        isSuperadmin()
        || resource.data.adminId == me()
        || resource.data.createdBy == me()
      ));
      allow create, update, delete: if false;
    }
    match /clientWallets/{docId} {
      allow read: if accountAllowed() && (hasModuleView("wallet") && (
        isSuperadmin()
        || (("adminId" in resource.data) && resource.data.adminId == me())
        || (("operadorId" in resource.data) && resource.data.operadorId == me())
      ));
      allow create, update, delete: if false;
    }
    match /ledgerEvents/{docId} {
      allow read: if accountAllowed() && (hasModuleView("wallet") && (
        isSuperadmin()
        || (("adminId" in resource.data) && resource.data.adminId == me())
        || (("operadorId" in resource.data) && resource.data.operadorId == me())
        || (("createdBy" in resource.data) && resource.data.createdBy == me())
      ));
      allow create, update, delete: if false;
    }
    match /activityLog/{docId} {
      // Coleccion legada: solo lectura durante la transicion, sin nuevas escrituras cliente.
      allow read: if accountAllowed() && (hasModuleView("actividad") && resource.data.rootId == myRootId() && (
        isSuperadmin()
        || (("adminId" in resource.data) && resource.data.adminId == me())
        || (("createdBy" in resource.data) && resource.data.createdBy == me())
        || (("actorUid" in resource.data) && resource.data.actorUid == me())
        || (("actorId" in resource.data) && resource.data.actorId == me())
      ));
      allow create, update, delete: if false;
    }

    match /pay0ActivityLog/{docId} {
      allow read: if accountAllowed() && (hasModuleView("actividad") && resource.data.rootId == myRootId()
        && resource.data.sourceSystem == "PAY0" && (
        isSuperadmin()
        || (("adminId" in resource.data) && resource.data.adminId == me())
        || (("createdBy" in resource.data) && resource.data.createdBy == me())
        || (("actorUid" in resource.data) && resource.data.actorUid == me())
        || (("actorId" in resource.data) && resource.data.actorId == me())
      ));
      allow create, update, delete: if false;
    }

    // Las bitacoras hermanas no son superficies PAY0. Sus futuros frontends
    // deberan usar callables/autorizacion propios; Hugo las consulta server-side.
    match /assetsActivityLog/{docId} {
      allow read, create, update, delete: if false;
    }
    match /tttActivityLog/{docId} {
      allow read, create, update, delete: if false;
    }
    match /hugoActivityLog/{docId} {
      allow read, create, update, delete: if false;
    }
    match /dispatchCompanyAccess/{despachoId} {
      allow read: if accountAllowed() && (hasModuleView("empresas") && (
        isSuperadmin()
        || hasDespachoAccess(despachoId)
      ));
      allow write: if accountAllowed() && (signedIn() && isSuperadmin());
    }

    match /dispatchCompanyAccess/{despachoId}/companies/{companyId} {
      allow read: if accountAllowed() && (hasModuleView("empresas") && (
        isSuperadmin()
        || hasDespachoAccess(despachoId)
      ));
      allow create, update, delete: if accountAllowed() && (signedIn() && isSuperadmin());
    }

    match /userClientAccess/{uid} {
      allow read: if accountAllowed() && (signedIn() && (isSuperadmin() || me() == uid || (hasModuleAction("usuarios", "clientDelegations") && iManageUser(uid))));
      allow write: if false;
    }

    match /userClientAccess/{uid}/clients/{clientId} {
      allow read: if accountAllowed() && (signedIn() && (isSuperadmin() || me() == uid || (hasModuleAction("usuarios", "clientDelegations") && iManageUser(uid))));
      allow create, update, delete: if false;
    }

    match /userCompanyAccess/{uid} {
      allow read: if accountAllowed() && (signedIn() && (isSuperadmin() || me() == uid || (hasModuleAction("usuarios", "permissions") && iManageUser(uid))));
      allow write: if accountAllowed() && (signedIn() && (isSuperadmin() || iManageUser(uid)));
    }

    match /userCompanyAccess/{uid}/companies/{companyId} {
      allow read: if accountAllowed() && (signedIn() && (isSuperadmin() || me() == uid || (hasModuleAction("usuarios", "permissions") && iManageUser(uid))));

      allow create, update, delete: if accountAllowed() && (signedIn() && (
        (isSuperadmin() && despachoAllowsCompany(targetDespachoId(uid), companyId))
        ||
        (iManageUser(uid)
          && despachoAllowsCompany(targetDespachoId(uid), companyId)
          && hasCompanyAccess(companyId)
        )
      ));
    }

    match /userDespachoAccess/{uid} {
      allow read: if accountAllowed() && (signedIn() && (isSuperadmin() || me() == uid || (hasModuleAction("usuarios", "permissions") && iManageUser(uid))));
      allow write: if accountAllowed() && (signedIn() && (isSuperadmin() || iManageUser(uid)));
    }

    match /userDespachoAccess/{uid}/despachos/{despachoId} {
      allow read: if accountAllowed() && (signedIn() && (isSuperadmin() || me() == uid || (hasModuleAction("usuarios", "permissions") && iManageUser(uid))));
      allow create, update, delete: if accountAllowed() && (signedIn() && (isSuperadmin() || iManageUser(uid)));
    }

    match /balanceAccounts/{docId} {
      allow read: if accountAllowed() && (hasModuleView("wallet") && (
        isSuperadmin()
        || (("adminId" in resource.data) && resource.data.adminId == me())
        || (("operadorId" in resource.data) && resource.data.operadorId == me())
        || (
          ("holderType" in resource.data)
          && resource.data.holderType == "USER"
          && ("holderId" in resource.data)
          && resource.data.holderId == me()
        )
      ));
      allow create, update, delete: if false;
    }

    match /balanceMovements/{docId} {
      allow read: if accountAllowed() && (hasModuleView("wallet") && (
        isSuperadmin()
        || (("adminId" in resource.data) && resource.data.adminId == me())
        || (("operadorId" in resource.data) && resource.data.operadorId == me())
        || (
          ("holderType" in resource.data)
          && resource.data.holderType == "USER"
          && ("holderId" in resource.data)
          && resource.data.holderId == me()
        )
      ));
      allow create, update, delete: if false;
    }

    match /clientBeneficiaries/{docId} {
      allow read: if accountAllowed() && (hasModuleAction("wallet", "beneficiarios") && (
        isSuperadmin()
        || (("adminId" in resource.data) && resource.data.adminId == me())
        || (("operadorId" in resource.data) && resource.data.operadorId == me())
        || (("createdBy" in resource.data) && resource.data.createdBy == me())
        || (("clientId" in resource.data) && hasWalletClientReadAccess(resource.data.clientId))
        || (("clienteId" in resource.data) && hasWalletClientReadAccess(resource.data.clienteId))
      ));
      allow create, update, delete: if false;
    }

    function userFundedDispersionScope(data) {
      return data.get("fundingSource", {}).get("holderType", "CLIENT") != "USER" || (
        data.get("rootId", "") == myRootId()
        && data.fundingSource.get("sourceClientId", "") == data.get("clientId", data.get("clienteId", ""))
        && data.get("ownerUid", "") == data.fundingSource.get("ownerUid", "")
        && (isSuperadmin() || data.fundingSource.get("ownerUid", "") == me())
      );
    }

    // These helpers are private to the dispersion parent and notes reads.
    // Actor values come only from the current users/{request.auth.uid} snapshot.
    function dispersionActorModuleAllowed(user, role) {
      return role == "superadmin" ? true : (
        roleDefaultAllowsForRole(role, "wallet", "view")
        && roleDefaultAllowsForRole(role, "wallet", "dispersiones")
        && individualAllowsViewAndActionForUser(user, "wallet", "dispersiones")
      );
    }
    function dispersionUserFundingAllowed(data, uid, role, rootId) {
      return data.get("fundingSource", {}).get("holderType", "CLIENT") != "USER" || (
        data.get("rootId", "") == rootId
        && data.fundingSource.get("sourceClientId", "") == data.get("clientId", data.get("clienteId", ""))
        && data.get("ownerUid", "") == data.fundingSource.get("ownerUid", "")
        && (role == "superadmin" || data.fundingSource.get("ownerUid", "") == uid)
      );
    }
    function dispersionDocumentOwnerAllowed(data, uid, role, notes) {
      return role == "superadmin" || (notes ? (
        data.adminId == uid || data.operadorId == uid || data.createdBy == uid
      ) : (
        (("adminId" in data) && data.adminId == uid)
        || (("operadorId" in data) && data.operadorId == uid)
        || (("createdBy" in data) && data.createdBy == uid)
      ));
    }
    function dispersionWalletClientAllowed(clientId, uid, role, rootId) {
      let clientPath = /databases/$(database)/documents/clients/$(clientId);
      let client = get(clientPath).data;
      let direct = (role == "admin" && (
        client.get("adminId", null) == uid
        || client.get("ownerId", null) == uid
        || client.get("managedByUserId", null) == uid
        || client.get("createdBy", null) == uid
        || client.get("operadorId", null) == uid
      )) || (role == "operador" && (
        client.get("managedByUserId", null) == uid
        || client.get("operadorId", null) == uid
        || client.get("createdBy", null) == uid
      ));
      return (clientId != null && exists(clientPath) && client.rootId == rootId)
        ? (direct ? true : clientDelegationPermissionForClient(clientId, client, rootId, "viewBasic", "view")) : false;
    }
    function dispersionWalletAliasesAllowed(data, uid, role, rootId) {
      let clientId = data.get("clientId", null);
      let legacyId = data.get("clienteId", null);
      return (("clientId" in data) && dispersionWalletClientAllowed(clientId, uid, role, rootId))
        || (legacyId != clientId ? (("clienteId" in data) && dispersionWalletClientAllowed(legacyId, uid, role, rootId)) : false);
    }
    function canReadClientDispersion(data, notes) {
      let uid = me();
      let user = userDoc(uid);
      let rawRole = user.get("role", "");
      let role = rawRole == "operator" ? "operador" : rawRole;
      let rawRoot = user.get("rootId", null);
      // Operational root historically falls back only for null, not other falsy values.
      let rootId = rawRoot != null ? rawRoot : uid;
      return (authenticated() && userExists(uid) && userLifecycleActive(user)) ? (
        restrictionAllowsUserForUid(user, uid, restrictionRoot(user, uid)) ? (
          dispersionActorModuleAllowed(user, role) ? (
            dispersionUserFundingAllowed(data, uid, role, rootId) ? (
              dispersionDocumentOwnerAllowed(data, uid, role, notes)
              || dispersionWalletAliasesAllowed(data, uid, role, rootId)
            ) : false
          ) : false
        ) : false
      ) : false;
    }

    match /clientDispersions/{docId} {
      allow read: if canReadClientDispersion(resource.data, false);
      allow create, update, delete: if false;
      match /notas/{notaId} {
        allow read: if canReadClientDispersion(get(/databases/$(database)/documents/clientDispersions/$(docId)).data, true);
        allow create, update, delete: if false;
      }
    }

    match /clientBeneficiaryMethods/{docId} {
      allow read: if accountAllowed() && (hasModuleAction("wallet", "beneficiarios") && (
        isSuperadmin()
        || (("adminId" in resource.data) && resource.data.adminId == me())
        || (("operadorId" in resource.data) && resource.data.operadorId == me())
        || (("createdBy" in resource.data) && resource.data.createdBy == me())
        || (("clientId" in resource.data) && hasWalletClientReadAccess(resource.data.clientId))
        || (("clienteId" in resource.data) && hasWalletClientReadAccess(resource.data.clienteId))
      ));
      allow create, update, delete: if false;
    }
    match /clientAdvances/{docId} {
      allow read: if accountAllowed() && (hasModuleAction("wallet", "adelantos") && (
        isSuperadmin()
        || (("adminId" in resource.data) && resource.data.adminId == me())
        || (("operadorId" in resource.data) && resource.data.operadorId == me())
      ));
      allow create, update, delete: if false;
    }

    match /telegramUpdates/{docId} {
      allow read: if accountAllowed() && (hasModuleView("telegram") && isSuperadmin());
      allow create, update, delete: if false;
    }

    match /telegramUsers/{telegramUserId} {
      allow read: if accountAllowed() && (hasModuleView("telegram") && (
        isSuperadmin()
        || (("uid" in resource.data) && resource.data.uid == me())
      ));
      allow create, update, delete: if false;
    }

    match /telegramLinkTokens/{docId} {
      allow read, write: if false;
    }

    match /telegramNotificationPrefs/{uid} {
      allow read: if accountAllowed() && (hasModuleView("telegram") && (isSuperadmin() || me() == uid));
      allow create, update, delete: if false;
    }

    match /telegramOutbox/{docId} {
      allow read: if accountAllowed() && (hasModuleView("telegram") && isSuperadmin());
      allow create, update, delete: if false;
    }


    // Canonical resources are served exclusively by root-scoped callables.
    match /pay0CanonicalResources/{id} { allow read, write: if false; }
    match /pay0CanonicalResourceVersions/{id} { allow read, write: if false; }
    match /pay0CanonicalAuditLog/{id} { allow read, write: if false; }
    match /pay0CanonicalUploadSessions/{id} { allow read, write: if false; }
    match /pagoReceiptIdentifications/{id} { allow read, write: if false; }
    match /commissionUserEntitlements/{id} { allow read, write: if false; }
    match /commissionUserEntitlementHistory/{id} { allow read, write: if false; }
    match /commissionUserDestinationRules/{id} { allow read, write: if false; }
    match /commissionUserDestinationHistory/{id} { allow read, write: if false; }
    match /commissionDailyRuns/{id} { allow read, write: if false; }
    match /commissionDailyRunPages/{id} { allow read, write: if false; }
    match /commissionDispersionRequests/{id} { allow read, write: if false; }
    match /commissionAutomationConfigs/{id} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
