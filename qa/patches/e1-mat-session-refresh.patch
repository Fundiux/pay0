+export interface MatHomeState<T> { home: T | null; loading: boolean; error: string; mode: MatHomeMode; }
+const empty = <T,>(mode: MatHomeMode = "LOCAL"): MatHomeState<T> => ({home:null,loading:false,error:"",mode});
+function useMatHome<T>(load:(initData:string)=>Promise<T>, errorMessage:string):MatHomeState<T> {
+  const { user } = useAuth();
+  const actor = user?.uid || "";
+  const actorRef = useRef(actor);
+  actorRef.current = actor;
+  const [snapshot,setSnapshot] = useState<{actor:string;state:MatHomeState<T>}>({actor,state:empty<T>()});
+  useEffect(()=>{
+    let disposed=false, generation=0, inFlight=false, queued=false;
+    let timer:ReturnType<typeof setTimeout>|undefined;
+    const current=()=>!disposed && actorRef.current===actor && (auth?.currentUser?.uid || "")===actor;
+    const publish=(state:MatHomeState<T>)=>{if(current())setSnapshot({actor,state});};
+    const refresh=()=>{
+      if(!current())return;
+      if(inFlight){queued=true;return;}
+      const initData=getTelegramInitData();
+      if(document.visibilityState==="hidden" || !initData){publish(empty(initData?"TELEGRAM":"LOCAL"));return;}
+      const request=generation;
+      inFlight=true;
+      publish({home:null,loading:true,error:"",mode:"TELEGRAM"});
+      void Promise.resolve().then(()=>{
+        if(!current() || request!==generation || document.visibilityState==="hidden" || getTelegramInitData()!==initData)return null;
+        return load(initData);
+      }).then(home=>{
+        if(!current() || request!==generation || document.visibilityState==="hidden" || getTelegramInitData()!==initData)return;
+        if(home!==null)publish({home,loading:false,error:"",mode:"TELEGRAM"});
+      }).catch(()=>{
+        if(current() && request===generation)publish({home:null,loading:false,error:errorMessage,mode:"TELEGRAM"});
+      }).finally(()=>{inFlight=false;if(queued && !disposed){queued=false;refresh();}});
     };
-  }, []);
-
-  return state;
-}
