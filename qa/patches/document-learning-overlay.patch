+export {};
+
+const original = require("./receipt-learning-baseline-index");
+const patched = require("./modules/pagos/receiptPdfCallables");
+const descriptors = Object.getOwnPropertyDescriptors(original);
+for (const name of ["parsePagoReceiptPdf", "correctPagoReceiptSemanticField"] as const) {
+  if (!Object.prototype.hasOwnProperty.call(descriptors, name) || typeof patched[name] !== "function") {
+    throw new Error("RECEIPT_EXPORT_CONTRACT");
+  }
+  descriptors[name] = {
+    enumerable: descriptors[name].enumerable,
+    configurable: descriptors[name].configurable,
+    writable: false,
+    value: patched[name],
+  };
+}
+module.exports = Object.defineProperties({}, descriptors);
